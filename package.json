{
  "name": "qureo-report",
  "version": "3.0.0",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "build:64": "pkg app.js --targets node22-win-x64 --output QureoReport_x64.exe",
    "build:32": "npx pkg@5.8.1 app.js --targets node18-win-x86 --output QureoReport_x86.exe"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.26.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
